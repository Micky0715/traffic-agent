OPENAI_API_KEY=your_key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
ROUTER_TEMPERATURE=0

# Vision (src/vision/qwen_vl_adapter.py). All four fall back to the
# OPENAI_* values above when unset, so a single-gateway setup only needs the
# vars above; set these separately if the VLM lives behind a different
# gateway/key than the text router.
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL_NAME=qwen-vl-max
VLM_TIMEOUT=60
VLM_MAX_RETRIES=2
